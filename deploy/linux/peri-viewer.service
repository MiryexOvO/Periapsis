[Unit]
Description=PERI native WebCodecs and WebTransport viewer
After=network.target peri-relay.service
Wants=peri-relay.service

[Service]
DynamicUser=yes
PrivateTmp=yes
EnvironmentFile=/etc/peri/viewer.env
LoadCredential=viewer.json:/etc/peri/viewer.json
Environment=PERI_CONFIG=%d/viewer.json
ExecStart=/opt/peri/bin/peri-webtransport watch
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
