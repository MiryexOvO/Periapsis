[Unit]
Description=PERI shared web preview
After=peri-relay.service
Wants=peri-relay.service

[Service]
DynamicUser=yes
PrivateTmp=yes
EnvironmentFile=/etc/peri/viewer.env
ExecStart=/usr/bin/python3 /opt/peri/web-preview.py 127.0.0.1:4444 localhost /etc/peri/cert.der live/av1 --peri /opt/peri/bin/peri --follow
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
